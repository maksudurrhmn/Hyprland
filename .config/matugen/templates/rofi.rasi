* {
    base: {{colors.background.dark.hex}};
    mantle: {{colors.surface_container_low.dark.hex}};
    crust: {{colors.surface_container_lowest.dark.hex}};

    text: {{colors.on_surface.dark.hex}};
    subtext0: {{colors.on_surface_variant.dark.hex}};
    subtext1: {{colors.secondary.dark.hex}};
    overlay0: {{colors.outline.dark.hex}};

    surface0: {{colors.surface_container.dark.hex}};
    surface1: {{colors.surface_container_high.dark.hex}};
    surface2: {{colors.surface_container_highest.dark.hex}};

    mauve: {{colors.tertiary.dark.hex}};
    lavender: {{colors.primary.dark.hex}};
    blue: {{colors.tertiary.dark.hex}};
    teal: {{colors.primary.dark.hex}};
    green: {{colors.secondary.dark.hex}};
    yellow: {{colors.tertiary_container.dark.hex}};
    peach: {{colors.secondary_container.dark.hex}};
    red: {{colors.error.dark.hex}};
}
