@import "/home/maksudurrhmn/.config/rofi/themes/wallpaper-colors.rasi"

configuration {
    show-icons: true;
    drun-display-format: "{name}";
}

* {
    background-color: transparent;
    text-color: @text;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location: center;
    width: 900px;
    background-color: @bg;
    border: 2px;
    border-color: @mauve;
    border-radius: 18px;
    padding: 12px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    background-color: @mantle;
    border-radius: 12px;
    padding: 12px 16px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @mauve;
}

entry {
    placeholder: "Search wallpapers...";
    placeholder-color: @overlay;
}

listview {
    columns: 4;
    lines: 2;
    spacing: 10px;
    fixed-height: true;
    height: 200px;
}

element {
    orientation: vertical;
    padding: 8px;
    border-radius: 12px;
    spacing: 8px;
}

element normal.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @surface;
    text-color: @mauve;
}

element-icon {
    size: 240px;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    text-color: inherit;
}
